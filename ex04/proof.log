== ex04: module auto-loaded when a USB keyboard is plugged in ==
# uname -r
6.14.0
[exit 0]
# cp /mnt/qemu_share/ex04/10-keyboard.rules /etc/udev/rules.d/10-keyboard.rules
[exit 0]
# cp /mnt/qemu_share/ex04/keyboard_driver.sh /usr/local/bin/keyboard_driver.sh
[exit 0]
# chmod +x /usr/local/bin/keyboard_driver.sh
[exit 0]
# sed -i 's|$KMOD_DIR|/mnt/qemu_share/ex04|g; s|$KNAME|keyboard-driver|g' /usr/local/bin/keyboard_driver.sh
[exit 0]
# cat /etc/udev/rules.d/10-keyboard.rules /usr/local/bin/keyboard_driver.sh
SUBSYSTEM=="usb", ACTION=="add", ATTR{bInterfaceClass}=="03", ATTR{bInterfaceProtocol}=="01", ENV{DEVPATH}=="/devices/*", RUN+="/usr/local/bin/keyboard_driver.sh"
SUBSYSTEM=="usb", ACTION=="change", ENV{DRIVER_UNLOAD}=="1", RUN+="/sbin/rmmod keyboard_driver"
#!/usr/bin/env bash

grep -q '^keyboard_driver ' /proc/modules || /sbin/insmod /mnt/qemu_share/ex04/keyboard-driver.ko
[exit 0]
# udevadm control --reload-rules
[exit 0]
# lsmod | grep keyboard_driver
[exit 1]
