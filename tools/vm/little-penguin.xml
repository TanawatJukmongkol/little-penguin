<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="kvm">
  <name>${VM_NAME}</name>
  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://libosinfo.org/linux/2022"/>
    </libosinfo:libosinfo>
  </metadata>
  <memory unit="KiB">4194304</memory>
  <currentMemory unit="KiB">4194304</currentMemory>
  <maxMemory unit="KiB" slots="16">8388608</maxMemory>
  <memoryBacking>
    <source type="memfd"/>
    <access mode="shared"/>
  </memoryBacking>
  <vcpu placement="static">${VCPU_COUNT}</vcpu>
  <os>
    <type arch="x86_64" machine="pc-i440fx-6.2">hvm</type>
    <loader readonly="yes" type="rom">${OVMF_PATH}</loader>
    <kernel>${KERNEL_IMG}</kernel>
    <cmdline>${CMDLINE}</cmdline>
    <boot dev="hd"/>
    <bootmenu enable="yes"/>
  </os>
  <features><acpi/><apic/></features>
  <cpu mode="host-passthrough" check="none" migratable="on">
    <topology sockets="${CPU_SOCKETS}" dies="1" cores="${CPU_CORES}" threads="${CPU_THREADS}"/>
    <feature policy="force" name="topoext"/>
    <numa>
      <cell id="0" cpus="0-${VCPU_LAST}" memory="4194304" unit="KiB"/>
    </numa>
  </cpu>
  <clock offset="utc">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>${QEMU_BIN}</emulator>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/>
      <source file="${VM_DISK_ABS}"/>
      <target dev="sda" bus="sata"/>
    </disk>
    <controller type="usb" index="0" model="qemu-xhci" ports="15"/>
    <controller type="pci" index="0" model="pci-root"/>
    <controller type="sata" index="0"/>
    <controller type="virtio-serial" index="0"/>
    <filesystem type="mount" accessmode="squash">
      <source dir="${PWD}"/>
      <target dir="qemu_share"/>
    </filesystem>
    <interface type="user"><model type="virtio"/></interface>
    <serial type="pty"><target type="isa-serial" port="0"/></serial>
    <console type="pty"><target type="serial" port="0"/></console>
    <audio id="1" type="none"/>
    <memballoon model="virtio"/>
    <memory model="virtio-mem">
      <target>
        <size unit="KiB">4194304</size>
        <node>0</node>
        <block unit="KiB">2048</block>
        <requested unit="KiB">0</requested>
      </target>
    </memory>
    <rng model="virtio"><backend model="random">/dev/urandom</backend></rng>
    <graphics type="spice" autoport="yes"/>
    <channel type="spicevmc">
      <target type="virtio" name="com.redhat.spice.0"/>
    </channel>
    <redirdev bus="usb" type="spicevmc">
      <address type="usb" bus="0" port="1"/>
    </redirdev>
    <redirdev bus="usb" type="spicevmc">
      <address type="usb" bus="0" port="2"/>
    </redirdev>
        <redirdev bus="usb" type="spicevmc">
      <address type="usb" bus="0" port="3"/>
    </redirdev>
        <redirdev bus="usb" type="spicevmc">
      <address type="usb" bus="0" port="4"/>
    </redirdev>
    <!-- Dynamic Video tag block populated exclusively on make vm-gui -->
    ${VIDEO_DEVICE}
  </devices>
  <!-- libvirt only honors this block under the exact qemu namespace URI
       above; any other URI drops it silently. SSH's port forward is added
       at runtime by the root Makefile (hostfwd_add). -->
  <qemu:commandline>
    <qemu:arg value="-gdb"/>
    <qemu:arg value="tcp:127.0.0.1:1122"/>
  </qemu:commandline>
</domain>
